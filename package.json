{
  "name": "iran-holidays",
  "version": "1.0.0",
  "description": "Generate official Iranian holiday JSON for any Solar Hijri year",
  "type": "module",
  "bin": {
    "iran-holidays": "./lib/cli.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/rewrite-declaration-extensions.js",
    "prepare": "pnpm run build",
    "create": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "keywords": [
    "iran",
    "holidays",
    "jalali",
    "hijri",
    "shamsi",
    "calendar"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
